{
  "manifest_version": 3,
  "name": "ChatSpace Bridge for CharmDate",
  "version": "1.0.0",
  "description": "Chrome Extension Bridge connecting CharmDate (Qpid Network) to ChatSpace Agency Multi-Chat",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.charmingdate.com/*",
    "http://localhost:3000/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.charmingdate.com/lady/*",
        "*://*.charmdate.com/lady/*"
      ],
      "js": ["content_login.js", "content_chat.js", "content_mail.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatSpace CharmDate Bridge"
  }
}
